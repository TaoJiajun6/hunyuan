# Git LFS 配置 - 跟踪大文件
# 跟踪 music 目录下的所有音频文件
music/**/*.mp3 filter=lfs diff=lfs merge=lfs -text
music/**/*.wav filter=lfs diff=lfs merge=lfs -text
music/**/*.m4a filter=lfs diff=lfs merge=lfs -text
music/**/*.flac filter=lfs diff=lfs merge=lfs -text
music/**/*.ogg filter=lfs diff=lfs merge=lfs -text
music/**/*.aac filter=lfs diff=lfs merge=lfs -text
# 如果 music 目录在根目录下，也可以直接使用：
# music/** filter=lfs diff=lfs merge=lfs -text
